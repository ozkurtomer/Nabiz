# Bu dosyayı .env.gercek adıyla kopyala ve doldur. .env.gercek'i kimseyle paylaşma / commit'leme.

# --- Veritabanı (şirket SQL Server) -----------------------------------------------------------
# Uygulamanın kendi tabloları "nabiz" şemasında oluşturulur; personel tablosuna yalnızca OKUMA yapılır.
# Docker Mac'te sunucunun makinendeki localhost'u için host.docker.internal kullan.
ConnectionStrings__Nabiz=Server=SUNUCU_ADI;Database=VERITABANI_ADI;User Id=KULLANICI;Password=SIFRE;TrustServerCertificate=True

# true: açılışta migration'ı uygular (nabiz şemasını ve tabloları oluşturur). DBA kendisi uygulayacaksa false yap.
Baslangic__OtomatikMigration=true

# İlk açılışta oluşturulacak İK hesabı. Sonra Kullanıcılar sayfasından diğer kişilere İK rolü verebilirsin.
# (Giriş e-posta linkiyle de yapılır; şifre yalnızca bu ilk hesap içindir.)
Baslangic__IlkIK__Email=ik@sirket.com
Baslangic__IlkIK__Sifre=GUCLU_BIR_SIFRE

# --- Güvenlik ----------------------------------------------------------------------------------
# En az 32 karakter, rastgele. Üretmek için:  openssl rand -base64 48
Jwt__Key=BURAYA_RASTGELE_UZUN_BIR_ANAHTAR_YAZ

# --- Adresler ----------------------------------------------------------------------------------
# Maillerdeki linklerin kök adresi: çalışanların tarayıcıdan ulaşacağı adres
Uygulama__PublicUrl=http://localhost:4200
Cors__Origins__0=http://localhost:4200
Zaman__SaatDilimi=Europe/Istanbul

# --- Personel tablosu (SALT OKUNUR) ------------------------------------------------------------
Personel__Tablo=dbo.Personel
Personel__SicilKolon=Sicil
Personel__AdKolon=AdSoyad
Personel__EmailKolon=Email
Personel__DepartmanKolon=Departman
Personel__AktifKolon=

# --- SMTP (şirket mail sunucusu) ---------------------------------------------------------------
Smtp__Host=smtp.sirket.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Kullanici=
Smtp__Sifre=
Smtp__Gonderen=nabiz@sirket.com
Smtp__GonderenAd=Nabız
